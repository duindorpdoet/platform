@@ -0,0 +1,145 @@
+"""Closed internet protocol. This module has no network or hardware side effects."""
+import base64
+import hashlib
+import hmac
+import json
+import math
+import re
+
+ENVELOPE = 'duinpad.actor-envelope.v1'
+COMMAND = 'duinpad.actor.v1'
+ACCESS = 'duinpad.actor-access.v1'
+STATUS = 'duinpad.actor-status.v1'
+MAX_STALE = 5
+# permission: (local role, internal zone, local action)
+ACTIONS = {
+    'heks.ready': ('heks', 1, 'ready'), 'heks.go': ('heks', 1, 'go'),
