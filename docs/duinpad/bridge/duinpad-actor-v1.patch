+            response, _ = self.pump(ws, self.request('GET', '/api/integration/actor-status', headers=self.header()))
+            self.assertEqual(response.status_code, 200)
+            self.assertEqual(response.json()['controls'][0]['action'], 'heks.ready')
+            self.assertNotIn('groups', response.json())
+            response, packets = self.pump(ws, self.request('POST', '/api/integration/actor-command', json=envelope, headers=self.header()), 2)
+            self.assertEqual([p['kind'] for p in packets], ['actor.access', 'actor.command'])
+            self.assertTrue(response.json()['ok']); self.assertTrue(self.c.ready[1])
+            self.assertEqual(response.json()['command_id'], command['command_id'])
+            changes = self.store.db.total_changes
+            receipt = '/api/integration/receipts/' + command['command_id'] + '?kind=actor&payload_hash=' + digest(compact(command))
+            response, _ = self.pump(ws, self.request('GET', receipt, headers=self.header()))
+            self.assertTrue(response.json()['found']); self.assertTrue(response.json()['result']['ok'])
+            self.assertEqual(self.store.db.total_changes, changes)
+            response, _ = self.pump(ws, self.request('POST', '/api/integration/actor-access', json=self.grant(False, 2), headers=self.auth))
+            self.assertTrue(response.json()['ok'])
+            response, _ = self.pump(ws, self.request('POST', '/api/integration/actor-command', json=envelope, headers=self.header()))
+            self.assertFalse(response.json()['ok'])
+        self.assertFalse(self.relay.pending)
+
+    def test_forged_signature_extra_args_stale_and_body_limit_rejected(self):
+        command = self.command()
+        cases = []
+        envelope = sign(self.env['DUINPAD_ACTOR_AUTH_SECRET'], command); envelope['signature'] = 'a' * 43; cases.append(envelope)
+        cases.append(sign(self.env['DUINPAD_ACTOR_AUTH_SECRET'], {**command, 'args': {'ready': True, 'zone': 5}}))
+        cases.append(sign(self.env['DUINPAD_ACTOR_AUTH_SECRET'], {**command, 'issued_at': time.time() - 30, 'expires_at': time.time() - 22}))
+        for envelope in cases:
+            self.assertIn(self.client.post('/api/integration/actor-command', json=envelope, headers=self.header()).status_code, (403, 409))
+        self.assertEqual(self.client.post('/api/integration/actor-command', content=b'x' * 5000, headers=self.header()).status_code, 409)
+        self.assertFalse(self.c.ready[1]); self.assertFalse(self.relay.pending)
+
+    def test_group_status_and_missing_receipt_are_filtered_and_safe(self):
+        with self.client.websocket_connect('/engine', headers=self.auth) as ws:
+            self.hello(ws)
+            response, _ = self.pump(ws, self.request('GET', '/api/integration/group-status?group_id=connection-check', headers=self.auth))
+            self.assertTrue(response.json()['connected']); self.assertNotIn('groups', response.json())
+            missing = '/api/integration/receipts/missing-command?group_id=A&payload_hash=' + 'a' * 64
+            response, _ = self.pump(ws, self.request('GET', missing, headers=self.auth))
+            self.assertFalse(response.json()['found']); self.assertTrue(response.json()['result']['unknown'])
+
+    def test_stale_status_is_never_accepted_as_current(self):
+        with self.client.websocket_connect('/engine', headers=self.auth) as ws:
+            self.hello(ws)
+            response, _ = self.pump(ws, self.request('GET', '/api/integration/actor-status', headers=self.header()),
+                                    mutate=lambda r: {**r, 'observed_at': time.time() - 6})
+            self.assertEqual(response.status_code, 504); self.assertTrue(response.json()['unknown'])
+
+    def test_disconnect_while_command_pending_is_unknown_without_queue(self):
+        command = self.command(); envelope = sign(self.env['DUINPAD_ACTOR_AUTH_SECRET'], command)
+        with self.client.websocket_connect('/engine', headers=self.auth) as ws:
+            self.hello(ws)
+            request = self.request('POST', '/api/integration/actor-command', json=envelope, headers=self.header())
+            access = ws.receive_json()
+            ws.send_json({'request_id': access['request_id'], 'event_id': access['event_id'], 'result': self.engine.handle(access)})
+            packet = ws.receive_json(); self.assertEqual(packet['kind'], 'actor.command'); ws.close()
