new file mode 100644
--- /dev/null
+++ b/tests/test_actor_protocol.py
@@ -0,0 +1,323 @@
+"""Isolated software protocol proof. All QLC and audio engines use SIMULATION."""
+import copy
+import json
+import os
+from pathlib import Path
+import queue
+import tempfile
+import threading
+import time
+import unittest
+from unittest.mock import patch
+import uuid
+
+from bridge.actor_adapter import ActorAdapter
+from bridge.actor_protocol import ACTIONS, ACCESS, COMMAND, b64encode, compact, digest, qr_payload, sign, validate, verify
+from bridge.audio import AudioEngine
+from bridge.config import read_config, ROOT
+from bridge.controller import Controller
+from bridge.qlc import QLC
+from bridge.relay_client import RelayClient
+from bridge.store import Store
+
+TEST_SECRET = 'simulation-only-actor-signing-secret-0000'
+EVENT = 'simulation-event'
+
+
+class ActorCase(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)
+        self.store = Store(Path(self.tmp.name) / 'show.db'); self.addCleanup(self.store.db.close)
+        self.now = 1000.0
+        self.cfg = read_config()
+        self.c = Controller(self.cfg, QLC(self.cfg, True, lambda: self.now), AudioEngine(self.cfg, True, lambda: self.now), self.store, True, lambda: self.now, lambda: self.now)
+        self.adapter = ActorAdapter(self.c, TEST_SECRET, EVENT)
+        self.act('program_start')
+
+    def act(self, action, args=None):
+        return self.c.action(action, args or {}, 'regie', uuid.uuid4().hex, self.now)
+
+    def grant(self, permissions, revision=1, active=True, subject='actor-A'):
+        return sign(TEST_SECRET, {'version': ACCESS, 'event_scope_id': EVENT, 'actor_subject': subject,
+                    'permissions_revision': revision, 'permissions': permissions, 'active': active,
+                    'issued_at': self.now, 'expires_at': self.now + 5})
+
+    def command(self, action, group=None, revision=1, subject='actor-A', args=None):
+        zone = ACTIONS[action][1]
+        return {'version': COMMAND, 'command_id': uuid.uuid4().hex, 'event_scope_id': EVENT,
+                'actor_subject': subject, 'permissions_revision': revision, 'action': action, 'group_id': group,
+                'args': args if args is not None else ({'ready': True} if action.endswith('.ready') else {}),
+                'issued_at': self.now, 'expires_at': self.now + 8,
+                'scope': {'permission': action, 'internal_zones': [] if zone is None else [zone]}}
+
+    def execute(self, command, permissions=None, **kwargs):
+        return self.adapter.execute(sign(TEST_SECRET, command), self.grant(permissions or [command['action']], revision=command['permissions_revision'], subject=command['actor_subject']), **kwargs)
+
+    def route(self):
+        self.act('group_add', {'group_id': 'A'})
+        self.now += 16
+        self.act('ready', {'zone': 1}); self.act('ready', {'zone': 5})
+        self.act('go', {'zone': 1})
+        # A periodic ticker preserves the unchanged local cue timing.
+        for _ in range(750):
+            self.now += .05; self.c.tick()
+        self.assertEqual(self.c._group('A')['status'], 'route')
+
+    def test_static_contract_fixture_cases(self):
+        fixtures = json.loads((ROOT / 'tests/fixtures/actor-v1-fixtures.json').read_text())
+        for case in fixtures['cases']:
+            with self.subTest(case=case['name']):
+                if case['valid']:
+                    validate(case['payload'], 'event-fixture', 1000)
+                else:
+                    with self.assertRaises((ValueError, PermissionError)):
+                        validate(case['payload'], 'event-fixture', 1000)
+
+    def test_hmac_is_over_exact_ascii_payload_and_rejects_changes(self):
+        payload = self.command('zone1.trigger')
+        env = sign(TEST_SECRET, payload)
+        self.assertEqual(verify(TEST_SECRET, env)[0], payload)
+        changed = dict(env); changed['payload'] = b64encode(compact({**payload, 'group_id': 'other'}))
+        with self.assertRaises(PermissionError): verify(TEST_SECRET, changed)
+        for value in ({**env, 'admin': True}, {**env, 'signature': 'A' * 43}, {**env, 'payload': env['payload'] + '='}):
+            with self.assertRaises((ValueError, PermissionError)): verify(TEST_SECRET, value)
+        with self.assertRaises(PermissionError): verify('other-isolated-signing-secret-000000', env)
+
+    def test_exact_cross_language_hmac_fixture(self):
+        fixture=json.loads((ROOT/'tests/fixtures/actor-v1-fixtures.json').read_text())['cases'][0]['payload']
+        self.assertEqual(sign('fixture-only-secret-32-characters-minimum',fixture)['signature'],
+                         'V3iWM0Sx4TZGK1cT-Em4GTByX5bITPnr5LblHwyi9l8')
+
+    def test_strict_args_scope_event_times_and_malformed_types(self):
+        command = self.command('zone1.trigger')
+        cases = [dict(command, args={'zone': 1}), dict(command, action='emergency'), dict(command, event_scope_id='another'),
+                 dict(command, expires_at=self.now + 9), dict(command, issued_at=self.now + 1),
+                 dict(command, expires_at=self.now), dict(command, permissions_revision=True),
+                 dict(command, scope=[]), dict(command, action=[]), dict(command, args=[]),
+                 dict(command, scope={'permission': 'zone1.trigger', 'internal_zones': [True]}),
+                 dict(command, group_id='A'), dict(command, admin=True)]
+        for value in cases:
+            with self.subTest(value=value):
+                with self.assertRaises((ValueError, PermissionError)): validate(value, EVENT, self.now)
+
+    def test_three_zone_permissions_map_only_to_internal_two_three_four(self):
+        self.route()
+        for action, zone in [('zone1.trigger', 2), ('zone2.trigger', 3), ('zone3.trigger', 4)]:
+            result = self.execute(self.command(action), ['zone1.trigger','zone2.trigger','zone3.trigger'])
+            self.assertTrue(result['ok']); self.assertIn(zone, self.c.active)
+        self.assertNotIn(1, self.c.active); self.assertNotIn(5, self.c.active)
+
+    def test_zone_stop_never_inherits_global_emergency(self):
+        self.route()
+        self.execute(self.command('zone1.trigger'))
+        cmd = self.command('zone1.stop', revision=2)
+        result = self.execute(cmd)
+        self.assertTrue(result['ok']); self.assertFalse(self.c.recovery); self.assertNotIn(2, self.c.active)
+        for zone in [1, 5]:
+            cmd = self.command('zone1.stop'); cmd['scope']['internal_zones'] = [zone]
+            with self.assertRaises(PermissionError): self.execute(cmd)
+        self.assertTrue(self.c.program)
+
+    def test_explicit_stop_all_is_required_for_emergency(self):
+        command = self.command('stop-all')
+        with self.assertRaises(PermissionError): self.execute(command, ['heks.go'])
+        self.assertFalse(self.c.recovery)
+        command = self.command('stop-all', revision=2)
+        self.assertTrue(self.execute(command)['ok']); self.assertTrue(self.c.recovery)
+
+    def test_status_is_strict_whitelist_and_contains_only_owned_controls(self):
+        self.act('group_add', {'group_id': 'A', 'label': 'DO NOT DISCLOSE'})
+        status = self.adapter.status(self.grant(['zone1.trigger']))
+        self.assertEqual(set(status), {'version', 'compatible', 'connected', 'observed_at', 'permissions_revision', 'controls'})
+        self.assertEqual(len(status['controls']), 1)
+        self.assertEqual(status['controls'][0]['action'], 'zone1.trigger')
+        self.assertFalse(status['controls'][0]['enabled'])
+        serialized = json.dumps(status)
+        for word in ['next_intro', 'next_finale', 'DO NOT DISCLOSE', 'groups', 'secret', 'DMX', 'master_gain']:
+            self.assertNotIn(word, serialized)
+
+    def test_heks_group_is_explicit_and_cannot_select_another_group(self):
+        self.act('group_add', {'group_id': 'A'}); self.act('group_add', {'group_id': 'B'})
+        self.now += 16; self.act('ready', {'zone': 1})
+        with self.assertRaises(PermissionError): self.execute(self.command('heks.go', 'B'))
+        self.assertNotIn(1, self.c.active)
+        self.assertTrue(self.execute(self.command('heks.go', 'A'))['ok'])
+
+    def test_concurrent_identical_actor_commands_execute_once(self):
+        self.route()
+        cmd = self.command('zone1.trigger'); envelope = sign(TEST_SECRET, cmd); grant = self.grant(['zone1.trigger'])
+        results = []
+        def run(): results.append(self.adapter.execute(envelope, grant))
+        count = self.c.audio.start_count
+        threads = [threading.Thread(target=run) for _ in range(8)]
+        for thread in threads: thread.start()
+        for thread in threads: thread.join(3); self.assertFalse(thread.is_alive())
+        self.assertEqual(self.c.audio.start_count, count + 1)
+        self.assertEqual(sum(bool(r.get('duplicate')) for r in results), 7)
+
+    def test_same_id_changed_signed_payload_is_rejected(self):
+        self.route(); cmd = self.command('zone1.trigger')
+        self.execute(cmd)
+        changed = copy.deepcopy(cmd); changed['action'] = 'zone1.stop'; changed['scope']['permission'] = 'zone1.stop'
+        with self.assertRaises(PermissionError): self.execute(changed, ['zone1.trigger', 'zone1.stop'])
+
+    def test_qr2_and_actor_finale_share_one_start_and_ack(self):
+        self.route()
+        cmd = self.command('finale.go', 'A')
+        event = {'stage': 'qr2', 'group_id': 'A', 'event_id': uuid.uuid4().hex, 'issued_at': self.now, 'label': ''}
+        count = self.c.audio.start_count
+        results = []
