+
+
+@unittest.skipUnless(importlib.util.find_spec('fastapi') and importlib.util.find_spec('httpx'),
+                     'Install deploy/requirements.txt and httpx to test optional VPS relay')
+class ActorRelayCase(unittest.TestCase):
+    def setUp(self):
+        from fastapi.testclient import TestClient
+        self.env = {'DUINPAD_RELAY_SECRET': 'simulation-relay-secret-0000000000000', 'DUINPAD_VISITOR_SECRET': 'simulation-visitor-secret-00000000000',
+                    'DUINPAD_GATE_QR1': 'simulation-gate-1-secret-000000000000', 'DUINPAD_GATE_QR2': 'simulation-gate-2-secret-000000000000',
+                    'DUINPAD_ACTOR_AUTH_SECRET': 'simulation-actor-secret-0000000000000', 'DUINPAD_EVENT_SCOPE_ID': 'event-simulation'}
+        spec = importlib.util.spec_from_file_location('actor_relay_test_' + uuid.uuid4().hex, ROOT / 'deploy/relay_app.py')
+        self.relay = importlib.util.module_from_spec(spec)
+        with patch.dict(os.environ, self.env): spec.loader.exec_module(self.relay)
+        self.client = TestClient(self.relay.app, base_url='https://testserver')
+        self.client.__enter__(); self.addCleanup(self.client.__exit__, None, None, None)
+        self.tmp = tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)
+        self.store = Store(Path(self.tmp.name) / 'show.db'); self.addCleanup(self.store.db.close)
+        cfg = read_config()
+        self.c = Controller(cfg, QLC(cfg, True), AudioEngine(cfg, True), self.store, True)
+        self.c.action('program_start', {}, 'regie', uuid.uuid4().hex, time.time())
+        with patch.dict(os.environ, self.env): self.engine = RelayClient(self.c)
+        self.auth = {'Authorization': 'Bearer ' + self.env['DUINPAD_RELAY_SECRET']}
+
+    def grant(self, active=True, revision=1):
+        now = time.time()
+        return sign(self.env['DUINPAD_ACTOR_AUTH_SECRET'], {'version': ACCESS, 'event_scope_id': self.env['DUINPAD_EVENT_SCOPE_ID'],
+            'actor_subject': 'actor-simulation', 'permissions_revision': revision, 'permissions': ['heks.ready'] if active else [],
+            'active': active, 'issued_at': now, 'expires_at': now + 5})
+
+    def command(self):
+        now = time.time()
+        return {'version': COMMAND, 'command_id': uuid.uuid4().hex, 'event_scope_id': self.env['DUINPAD_EVENT_SCOPE_ID'],
+                'actor_subject': 'actor-simulation', 'permissions_revision': 1, 'action': 'heks.ready', 'group_id': None,
+                'args': {'ready': True}, 'issued_at': now, 'expires_at': now + 8,
+                'scope': {'permission': 'heks.ready', 'internal_zones': [1]}}
+
+    def header(self, grant=None):
+        return {**self.auth, 'X-Duinpad-Actor-Grant': b64encode(compact(grant or self.grant()))}
+
+    def hello(self, ws, **changes):
+        ws.send_json({'type': 'capabilities', 'versions': [COMMAND], 'event_scope_id': self.env['DUINPAD_EVENT_SCOPE_ID'],
+                      'actor_status_max_age': 5, 'zone_stops': [2, 3, 4], **changes})
+
+    def request(self, method, url, **kwargs):
+        results = queue.Queue()
+        def run():
+            try: results.put(self.client.request(method, url, **kwargs))
+            except BaseException as exc: results.put(exc)
+        thread = threading.Thread(target=run); thread.start()
+        return results, thread
+
+    def pump(self, ws, request, count=1, mutate=None):
+        packets = []
+        for _ in range(count):
+            body = ws.receive_json(); packets.append(body)
+            result = self.engine.handle(body)
+            if mutate: result = mutate(result)
+            ws.send_json({'request_id': body['request_id'], 'event_id': body['event_id'], 'result': result})
+        results, thread = request; thread.join(4); self.assertFalse(thread.is_alive())
+        response = results.get(timeout=1)
+        if isinstance(response, BaseException): raise response
+        return response, packets
+
+    def test_actor_protocol_requires_auth_fresh_scope_and_negotiation(self):
+        payload = self.command(); envelope = sign(self.env['DUINPAD_ACTOR_AUTH_SECRET'], payload)
+        self.assertEqual(self.client.post('/api/integration/actor-command', json=envelope).status_code, 403)
+        self.assertEqual(self.client.post('/api/integration/actor-command', json=envelope, headers=self.header()).status_code, 503)
+        with self.client.websocket_connect('/engine', headers=self.auth) as ws:
+            self.assertEqual(self.client.get('/api/integration/actor-status', headers=self.header()).status_code, 503)
+            self.hello(ws, event_scope_id='another-event')
+            self.assertEqual(self.client.get('/api/integration/actor-status', headers=self.header()).status_code, 503)
+        self.assertFalse(self.c.ready[1]); self.assertFalse(self.relay.pending)
+
+    def test_command_status_revocation_and_readonly_receipt_end_to_end(self):
