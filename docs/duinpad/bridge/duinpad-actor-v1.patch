+++ b/bridge/actor_adapter.py
@@ -0,0 +1,194 @@
+"""Internet commands are translated here, never forwarded as arbitrary local actions."""
+import os
+import re
+import threading
+from .actor_protocol import ACTIONS, MAX_STALE, STATUS, digest, qr_payload, validate, verify
+from .visitor import public_result
+
+
+class ActorAdapter:
+    def __init__(self, controller, secret=None, event_scope_id=None):
+        self.controller = controller
+        self.secret = os.getenv('DUINPAD_ACTOR_AUTH_SECRET', '') if secret is None else secret
+        self.event_scope_id = os.getenv('DUINPAD_EVENT_SCOPE_ID', '') if event_scope_id is None else event_scope_id
+        self.access_lock = threading.RLock()
+
+    @property
+    def compatible(self):
+        return len(self.secret) >= 32 and bool(self.event_scope_id)
+
+    def grant(self, envelope):
+        data, _ = verify(self.secret, envelope)
+        validate(data, self.event_scope_id, self.controller.wall(), access=True)
+        with self.access_lock:
+            self.controller.store.set_access(data)
+        return data
+
+    def _current(self, data, permission=None, fresh=True):
+        stored = self.controller.store.access(data['actor_subject'])
+        now = self.controller.wall()
+        if not stored or not stored['active'] or stored['permissions_revision'] != data['permissions_revision']:
+            raise PermissionError('Acteursrecht ingetrokken of gewijzigd')
+        if stored['event_scope_id'] != data['event_scope_id'] or (fresh and (not 0 <= now - stored['issued_at'] <= MAX_STALE or now >= stored['expires_at'])):
+            raise PermissionError('Acteursrechten verouderd; vernieuw de status')
+        if permission is not None and permission not in stored['permissions']:
+            raise PermissionError('Deze knop is niet toegewezen')
+        return stored
+
+    def status(self, envelope):
+        grant = self.grant(envelope)
+        c = self.controller
+        with c.lock, self.access_lock:
+            current = self._current(grant)
+            # Construct a whitelist from local facts. Never serialize public(role).
+            controls = []
+            for action in current['permissions']:
+                role, zone, local = ACTIONS[action]
+                group = None
+                reason = None
+                if not c.connected or not c.qlc.connected or not c.audio.connected:
+                    reason = 'Geen verbinding met de showcomputer'
+                elif local == 'ready':
+                    if c.recovery: reason = 'Bewust herstel nodig'
+                    elif zone in c.active: reason = 'Effect speelt'
+                    elif zone == 5 and c.states[5] == 'RESET' and c.clock() < getattr(c, 'reset_after', 0):
+                        reason = 'Wacht op uitstroom/reset-tijd'
+                elif local == 'go':
+                    if zone == 1:
+                        reason = c._intro_reason(); group = c._next_intro()
+                    elif zone == 5:
+                        reason = c._finale_reason(); group = c._next_finale()
+                    else:
+                        reason = ('Bewust herstel nodig' if c.recovery else 'Finale bestuurt het pad' if 5 in c.active
+                                  else 'Start eerst het programma' if not c.program else 'Instroom gepauzeerd' if c.paused
+                                  else 'Wacht op einde heks' if not c.pad_on else 'Effect speelt' if zone in c.active else None)
+                    if group:
+                        slot = c.store.finale_slot(group['id']) if zone == 5 else None
+                        if slot and slot['status']!='not_executed': reason = 'Finale voor deze groep is al gestart' if slot['status'] == 'started' else 'Finale-uitkomst onbekend; controleer de regie'
+                elif local == 'stop_zone' and 5 in c.active:
+                    reason = 'Finale bestuurt het pad'
+                run = c.active.get(zone)
+                controls.append({'action': action, 'enabled': reason is None, 'blocked_reason': reason,
+                                 'group_id': group['id'] if group else None,
+                                 'effect': {'active': bool(run), 'remaining': round(max(0, run['duration'] - (c.clock() - run['started'])), 2) if run else 0}})
+            return {'version': STATUS, 'compatible': self.compatible, 'connected': bool(c.connected and c.qlc.connected and c.audio.connected),
+                    'observed_at': c.wall(), 'permissions_revision': current['permissions_revision'], 'controls': controls}
+
+    def execute(self, envelope, grant, live=lambda: True):
+        data, payload_hash = verify(self.secret, envelope)
+        validate(data, self.event_scope_id, self.controller.wall())
+        granted = self.grant(grant)
+        if any(data[k] != granted[k] for k in ('actor_subject', 'event_scope_id', 'permissions_revision')):
+            raise PermissionError('Actorautorisatie hoort niet bij deze opdracht')
+        c = self.controller
+        # Recheck everything after acquiring the execution lock; queued commands never
+        # survive their deadline, revocation, disconnect or local recovery state.
+        with c.lock, self.access_lock:
+            validate(data, self.event_scope_id, c.wall())
+            self._current(data, data['action'])
+            if not live(): raise PermissionError('Verbinding verbroken; opdracht niet uitgevoerd')
+            previous = c.store.remote(data['command_id'])
+            if previous:
+                self._match(previous, 'actor', data['group_id'], payload_hash, data['actor_subject'])
+                return {**previous['result'], 'duplicate': True}
+            role, zone, local = ACTIONS[data['action']]
+            if data['action'] in ('heks.go', 'finale.go'):
+                current_group = c._next_intro() if zone == 1 else c._next_finale()
+                slot = c.store.finale_slot(data['group_id']) if zone == 5 else None
+                if (not slot or slot['status']=='not_executed') and (not current_group or current_group['id'] != data['group_id']):
+                    raise PermissionError('Groep is niet meer de actuele groep')
+            c.store.reserve_remote(data['command_id'], 'actor', self.event_scope_id, data['actor_subject'], data['group_id'], payload_hash)
+            args = {} if zone is None else {'zone': zone}
+            if local == 'ready': args['ready'] = data['args']['ready']
+            # The existing narrow finale role uses the same bound start function
+            # as QR2. It never inherits a generic regie execution permission.
+            if data['action'] == 'finale.go':
+                args['group_id'] = data['group_id']
+            result = self._execute_local(local, args, role, data['command_id'], data['issued_at'])
+            result['command_id'] = data['command_id']
+            if result.get('ok'):
+                result['meaning'] = ('finale_started' if data['action'] == 'finale.go' else 'scene_started' if local == 'go'
+                                     else 'ready_updated' if local == 'ready' else 'all_stopped' if local == 'emergency' else 'zone_stopped')
+                if data['action'] == 'finale.go': result['confirmation'] = {'qlc_started': True, 'audio_started': True}
+            c.store.finish_remote(data['command_id'], result)
+            return result
+
+    def qr(self, event, deadline, live=lambda: True):
+        c = self.controller
+        with c.lock:
+            if deadline <= c.wall() or not live():
+                raise ValueError('Verlopen of verbroken relay-opdracht; niet uitgevoerd')
+            stage, gid, ident = event['stage'], event['group_id'], event['event_id']
+            if stage not in ('qr1', 'qr2') or not re.fullmatch(r'[A-Za-z0-9_-]{1,40}', gid):
+                raise ValueError('Ongeldige QR-opdracht')
+            payload_hash = digest(qr_payload(event))
+            previous = c.store.remote(ident)
+            if previous:
+                self._match(previous, 'qr', gid, payload_hash, None)
+                return {**previous['result'], 'duplicate': True}
+            c.store.reserve_remote(ident, 'qr', self.event_scope_id, None, gid, payload_hash)
+            args = {'group_id': gid}
+            if stage == 'qr1': args['label'] = event.get('label', '')
+            result = self._execute_local('group_add' if stage == 'qr1' else 'qr2_start', args, 'regie', ident, event['issued_at'])
+            c.store.finish_remote(ident, result)
+            return public_result(result)
+
+    def _execute_local(self, action, args, role, ident, issued):
+        try:
+            result = public_result(self.controller.action(action, args, role, ident, issued))
+            return {**result, 'outcome': 'unknown' if result.get('unknown') else 'started' if result.get('ok') else 'blocked'}
+        except (ValueError, PermissionError) as exc:
+            # A scene may have started before a value error (e.g. audio callback).
+            # Any reserved finale slot without both start ACKs is always unknown.
+            is_finale=action=='qr2_start' or (action=='go' and args.get('zone')==5)
+            slot = self.controller.store.finale_slot(args.get('group_id')) if is_finale else None
+            if slot and slot['status'] == 'unknown':
+                return {'ok': False, 'unknown': True, 'outcome': 'unknown', 'error': 'Geen startbevestiging ontvangen. Vraag de begeleider om de regie te controleren.'}
+            return {'ok': False, 'outcome': 'blocked', 'error': str(exc)}
+        except Exception:
+            return {'ok': False, 'unknown': True, 'outcome': 'unknown', 'error': 'Geen startbevestiging ontvangen. Vraag de begeleider om de regie te controleren.'}
+
+    def _match(self, row, kind, gid, payload_hash, subject):
+        if row['kind'] != kind or row['event_scope_id'] != self.event_scope_id or row['group_id'] != gid or row['payload_hash'] != payload_hash or row['actor_subject'] != subject:
+            raise PermissionError('Ontvangst hoort niet bij deze aanvraag')
+
+    def receipt(self, ident, kind, gid, payload_hash, grant=None):
+        subject = None
+        if kind == 'actor':
+            # A receipt query never installs a capability or modifies any ledger.
+            data, _ = verify(self.secret, grant)
+            validate(data, self.event_scope_id, self.controller.wall(), access=True)
+            with self.access_lock: self._current(data, fresh=False)
+            subject = data['actor_subject']
+        elif kind != 'qr':
+            raise ValueError('Onbekend ontvangsttype')
+        row = self.controller.store.remote(ident)
+        if row is None:
+            # Absence of this ledger does not prove physical non-execution.
+            return {'found':False,'command_id':ident,'group_id':gid,'payload_hash':payload_hash,
+                    'result':{'ok': False, 'unknown': True, 'outcome': 'unknown', 'error': 'Geen lokale ontvangst gevonden; controleer de regie'}}
+        self._match(row, kind, gid, payload_hash, subject)
+        result = dict(row['result'])
+        group = self.group_status(gid) if gid else None
+        # A crash can occur after both ACKs were durably recorded but before the
+        # outer attempt was finalized. Read that concrete evidence without writes.
+        slot = self.controller.store.finale_slot(gid) if gid else None
+        if result.get('unknown') and slot and slot['event_id'] == ident and slot['status'] == 'started':
+            result = {'ok': True, 'outcome': 'started', 'meaning':'finale_started', 'confirmation': {'qlc_started': True, 'audio_started': True}}
+        resolution=self.controller.store.finale_resolution(ident)
+        if result.get('unknown') and resolution and resolution['group_id']==gid:
+            result={'ok':False,'outcome':'blocked','message':'Regie heeft lokaal gecontroleerd en bevestigd: de finale is niet uitgevoerd.'}
+        if kind=='actor':result['command_id']=ident
+        return {'found':True,'command_id':ident,'group_id':gid,'payload_hash':payload_hash,'result':result,'group':group}
+
+    def group_status(self, gid):
+        c = self.controller
+        with c.lock:
+            slot = c.store.finale_slot(gid)
+            group = next((g for g in c.groups if g['id'] == gid), None)
+            return {'group_id': gid, 'observed_at': c.wall(), 'connected':bool(c.connected and c.qlc.connected and c.audio.connected), 'registered': group is not None,
+                    'finale_started': bool(slot and slot['status'] == 'started'),
+                    'released': bool(slot and slot['status'] == 'started'),
+                    'outcome': slot['status'] if slot else 'not_requested',
+                    'recovery_required': bool(c.recovery or (slot and slot['status'] == 'unknown')),
+                    'group_status': group['status'] if group else None}
